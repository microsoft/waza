{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microsoft.github.io/waza/schemas/execution-lifecycle-inspection-1.0.schema.json",
  "title": "Caller-retained lifecycle inspection context",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "original_admission", "reservation_digest", "observation_digests", "stale_after_ms"],
  "properties": {
    "kind": {"const": "waza.execution-lifecycle-inspection"},
    "schema_version": {"const": "1.0"},
    "original_admission": {"$ref": "artifact-manifest-1.0.schema.json#/properties/binding"},
    "reservation_digest": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
    "observation_digests": {
      "type": "array", "maxItems": 128, "uniqueItems": true,
      "items": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"}
    },
    "deadline": {"$ref": "#/$defs/time"},
    "as_of": {"$ref": "#/$defs/time"},
    "stale_after_ms": {"type": "integer", "minimum": 1, "maximum": 86400000}
  },
  "$defs": {
    "time": {"type": "string", "maxLength": 30, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"}
  }
}
