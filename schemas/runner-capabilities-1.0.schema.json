{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microsoft.github.io/waza/schemas/runner-capabilities-1.0.schema.json",
  "title": "Waza runner capability advertisement 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "versions", "capabilities"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}},
    "capabilities": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}
    }
  }
}
