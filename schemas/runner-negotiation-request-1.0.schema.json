{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microsoft.github.io/waza/schemas/runner-negotiation-request-1.0.schema.json",
  "title": "Waza runner negotiation request 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "versions", "required_capabilities", "optional_capabilities"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "versions": {
      "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
      "items": {"type": "string", "maxLength": 32, "pattern": "^[0-9]+\\.[0-9]+$"}
    },
    "required_capabilities": {"$ref": "#/$defs/capabilities"},
    "optional_capabilities": {"$ref": "#/$defs/capabilities"}
  },
  "$defs": {
    "capabilities": {
      "type": "array", "maxItems": 64, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}
    }
  }
}
