{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microsoft.github.io/waza/schemas/provenance-bundle-1.0.schema.json",
  "title": "Waza provenance bundle index 1.0",
  "description": "Unsigned bundle entry point (bundle.json). It locates the DSSE envelope and names the signer mode; trust comes only from the verifier's configured keys and the signed statement.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "envelope", "signer"],
  "properties": {
    "kind": {"const": "waza.provenance-bundle"},
    "schema_version": {"const": "1.0"},
    "envelope": {"const": "statement.dsse.json"},
    "signer": {
      "type": "object", "additionalProperties": false, "required": ["mode", "key_id"],
      "properties": {
        "mode": {"enum": ["local-ed25519", "sigstore-keyless", "managed-kms"]},
        "key_id": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    }
  }
}
