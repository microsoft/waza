{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microsoft.github.io/waza/schemas/execution-lifecycle-source-inspection-1.0.schema.json",
  "title": "Read-only original finalized lifecycle source selection",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "source", "stale_after_ms"],
  "properties": {
    "kind": {"const": "waza.execution-lifecycle-source-inspection"},
    "schema_version": {"const": "1.0"},
    "source": {"$ref": "execution-attempt-1.0.schema.json#/$defs/source"},
    "as_of": {"type": "string", "minLength": 20, "maxLength": 30, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"},
    "stale_after_ms": {"type": "integer", "minimum": 1, "maximum": 86400000}
  }
}
