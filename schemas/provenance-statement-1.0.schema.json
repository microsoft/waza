{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microsoft.github.io/waza/schemas/provenance-statement-1.0.schema.json",
  "title": "Waza execution provenance statement 1.0",
  "description": "In-toto v1 statement carried as the DSSE payload of a Waza provenance bundle. Derived claims are recomputed from bundle members during verification; image and Waza version are declared claims covered only by the signature.",
  "type": "object",
  "additionalProperties": false,
  "required": ["_type", "subject", "predicateType", "predicate"],
  "properties": {
    "_type": {"const": "https://in-toto.io/Statement/v1"},
    "subject": {
      "type": "array", "minItems": 2, "maxItems": 129,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "digest"],
        "properties": {
          "name": {"$ref": "#/$defs/path"},
          "digest": {
            "type": "object", "additionalProperties": false, "required": ["sha256"],
            "properties": {"sha256": {"$ref": "#/$defs/sha256"}}
          }
        }
      }
    },
    "predicateType": {"const": "https://microsoft.github.io/waza/provenance/execution/v1"},
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "waza", "runner", "inputs", "policy", "runtime", "artifacts", "outcome", "bindings"],
      "properties": {
        "profile": {"const": "waza.execution-provenance/1.0"},
        "waza": {
          "type": "object", "additionalProperties": false, "required": ["version"],
          "properties": {"version": {"type": "string", "minLength": 1, "maxLength": 128}}
        },
        "runner": {
          "type": "object", "additionalProperties": false,
          "required": ["api_version", "request_schema_version", "image"],
          "properties": {
            "api_version": {"type": "string", "minLength": 1, "maxLength": 16},
            "request_schema_version": {"type": "string", "minLength": 1, "maxLength": 16},
            "image": {
              "description": "Declared runner image; compare with --expect-image-digest to bind the consumed image.",
              "type": "object", "additionalProperties": false, "required": ["reference", "digest"],
              "properties": {
                "reference": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^\\S+$"},
                "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
              }
            }
          }
        },
        "inputs": {
          "type": "object", "additionalProperties": false, "required": ["request", "identity"],
          "properties": {
            "request": {"$ref": "#/$defs/ref"},
            "identity": {"$ref": "runner-terminal-1.0.schema.json#/$defs/identity"}
          }
        },
        "policy": {"$ref": "#/$defs/ref"},
        "runtime": {
          "type": "object", "additionalProperties": false, "required": ["execution_mode", "executor", "model"],
          "properties": {
            "execution_mode": {"enum": ["mock", "copilot"]},
            "executor": {"enum": ["mock", "copilot-sdk"]},
            "model": {"type": "string", "minLength": 1, "maxLength": 256}
          }
        },
        "artifacts": {
          "type": "object", "additionalProperties": false, "required": ["manifest", "objects"],
          "properties": {
            "manifest": {"$ref": "#/$defs/ref"},
            "objects": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/ref"}}
          }
        },
        "outcome": {
          "type": "object", "additionalProperties": false,
          "required": ["artifact", "outcome", "exit_code", "failure_boundary"],
          "properties": {
            "artifact": {"$ref": "#/$defs/ref"},
            "outcome": {"$ref": "runner-terminal-1.0.schema.json#/properties/outcome"},
            "exit_code": {"type": "integer", "minimum": 0, "maximum": 6},
            "failure_boundary": {"$ref": "runner-terminal-1.0.schema.json#/properties/failure_boundary"}
          }
        },
        "bindings": {
          "description": "Extension point: additional members bound by digest (for example component inventories). Each kind requires a registered verifier; unknown kinds fail verification.",
          "type": "array", "maxItems": 16,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["kind", "path", "sha256", "media_type"],
            "properties": {
              "kind": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,63}$"},
              "path": {"$ref": "#/$defs/path"},
              "sha256": {"$ref": "#/$defs/sha256"},
              "media_type": {"type": "string", "minLength": 1, "maxLength": 128}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[a-z]+(/[a-z]+)*/[a-zA-Z0-9][a-zA-Z0-9._-]*$"},
    "ref": {
      "type": "object", "required": ["path", "sha256", "media_type"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "media_type": {"type": "string", "minLength": 1, "maxLength": 128}
      },
      "additionalProperties": false
    }
  }
}
