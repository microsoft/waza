{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microsoft.github.io/waza/schemas/execution-submission-1.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "request"],
  "properties": {
    "kind": {"const": "waza.execution-submission"},
    "schema_version": {"const": "1.0"},
    "request": {"$ref": "runner-request-1.0.schema.json"},
    "policy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {"const": "distinct"},
            "parent": {"$ref": "execution-attempt-1.0.schema.json#/$defs/parent"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "source"],
          "properties": {
            "mode": {"const": "reuse"},
            "source": {"$ref": "execution-attempt-1.0.schema.json#/$defs/source"}
          }
        }
      ]
    }
  }
}
