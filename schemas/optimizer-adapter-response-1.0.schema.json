{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microsoft.github.io/waza/schemas/optimizer-adapter-response-1.0.schema.json",
  "title": "Waza optimizer adapter response 1.0",
  "description": "One JSON document a command adapter writes to stdout. Unknown fields are rejected.",
  "type": "object",
  "oneOf": [
    {
      "additionalProperties": false,
      "required": ["kind", "contract_version", "adapter"],
      "properties": {
        "kind": {"const": "waza.optimizer-adapter-response"},
        "contract_version": {"const": "1.0"},
        "adapter": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "version", "contract_versions", "required_capabilities", "optional_capabilities", "paid_calls"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "contract_versions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "required_capabilities": {"type": ["array", "null"], "items": {"type": "string"}},
            "optional_capabilities": {"type": ["array", "null"], "items": {"type": "string"}},
            "paid_calls": {"type": "boolean"}
          }
        }
      }
    },
    {
      "additionalProperties": false,
      "required": ["kind", "contract_version"],
      "anyOf": [{"required": ["candidate"]}, {"required": ["done"], "properties": {"done": {"const": true}}}],
      "properties": {
        "kind": {"const": "waza.optimizer-adapter-response"},
        "contract_version": {"const": "1.0"},
        "candidate": {
          "type": "object", "additionalProperties": false,
          "required": ["parent_id", "files"],
          "properties": {
            "parent_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "files": {
              "type": "array", "minItems": 1, "maxItems": 64,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["path", "content"],
                "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 200}, "content": {"type": "string"}}
              }
            },
            "rationale": {"type": "string"}
          }
        },
        "done": {"type": "boolean"},
        "usage": {
          "type": "object", "additionalProperties": false,
          "required": ["input_tokens", "output_tokens", "premium_requests"],
          "properties": {
            "input_tokens": {"type": "integer", "minimum": 0},
            "output_tokens": {"type": "integer", "minimum": 0},
            "premium_requests": {"type": "number", "minimum": 0, "description": "GitHub Copilot premium requests only."},
            "ai_credits": {"type": "number", "minimum": 0},
            "provider": {"type": "string", "minLength": 1, "description": "Custom model provider whose request count is in provider_requests."},
            "provider_requests": {"type": "number", "minimum": 0}
          }
        }
      }
    }
  ]
}
