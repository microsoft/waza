{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microsoft.github.io/waza/schemas/runner-unit-1.0.schema.json",
  "title": "Invocation-local exact work receipt (not a terminal envelope)",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "status", "compatibility", "validation", "adjacent_work_selected", "engine_calls", "diagnostics"],
  "properties": {
    "kind": {"const": "waza.runner-unit"},
    "schema_version": {"const": "1.0"},
    "status": {"enum": ["ready", "rejected", "completed", "execution_error"]},
    "compatibility": {"$ref": "runner-negotiation-response-1.0.schema.json"},
    "requested": {"$ref": "#/$defs/selection"},
    "resolved": {"$ref": "#/$defs/selection"},
    "validation": {"enum": ["not_checked", "invalid", "valid"]},
    "adjacent_work_selected": {"const": false},
    "execution_mode": {"const": "mock"},
    "engine_calls": {"type": "integer", "minimum": 0, "maximum": 1},
    "observation": {"type": "object", "description": "Original RunResult from this mock attempt, not a versioned terminal result. No archive reader is provided."},
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["code", "message"],
        "properties": {"code": {"type": "string"}, "message": {"type": "string"}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["ready", "rejected"]}}},
      "then": {"properties": {"engine_calls": {"const": 0}}, "not": {"anyOf": [{"required": ["observation"]}, {"required": ["execution_mode"]}]}}
    },
    {
      "if": {"properties": {"status": {"const": "ready"}}},
      "then": {"required": ["requested", "resolved"], "properties": {"validation": {"const": "valid"}, "diagnostics": {"maxItems": 0}, "compatibility": {"properties": {"status": {"const": "compatible"}}}}}
    },
    {
      "if": {"properties": {"status": {"const": "rejected"}}},
      "then": {"properties": {"validation": {"enum": ["invalid", "not_checked"]}}, "not": {"required": ["resolved"]}}
    },
    {
      "if": {"properties": {"status": {"enum": ["completed", "execution_error"]}}},
      "then": {"required": ["requested", "resolved", "execution_mode"], "properties": {"validation": {"const": "valid"}, "compatibility": {"properties": {"status": {"const": "compatible"}}}}}
    },
    {
      "if": {"properties": {"status": {"const": "completed"}}},
      "then": {"required": ["observation"], "properties": {"engine_calls": {"const": 1}, "diagnostics": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"status": {"const": "execution_error"}}},
      "then": {"properties": {"diagnostics": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "selection": {
      "type": "object", "additionalProperties": false,
      "required": ["shard", "task", "trial", "attempt"],
      "properties": {
        "shard": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "task": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "trial": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "attempt": {"type": "integer", "minimum": 1, "maximum": 2147483647}
      }
    }
  }
}
