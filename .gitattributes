internal/nativesnapshot/testdata/g2-original/nativesnapshot-files.go.original -text
internal/nativesnapshot/testdata/g2-original/nativesnapshot-join.go.original -text
internal/nativesnapshot/testdata/g2-original/nativesnapshot-snapshot.go.original -text
