# Squad: union merge for append-only team state files
.squad/decisions.md merge=union
.squad/agents/*/history.md merge=union
.squad/log/** merge=union
.squad/orchestration-log/** merge=union
# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto
# Squad commits hash these exact bytes; Windows checkout must retain LF.
.squad/casting/registry.json text eol=lf
.squad/casting/history.json text eol=lf
.squad/casting/legacy-v0.10.0/** -text
testdata/frozen-assurance-readers/** -text
schemas/grader-assurance-1.0.schema.json text eol=lf
schemas/grader-reference-1.0.schema.json text eol=lf
schemas/evidence-manifest-1.0.schema.json text eol=lf
examples/grader-challenges/authored-output/eval.yaml text eol=lf
*.zst filter=lfs diff=lfs merge=lfs -text
internal/embedded/zcopilotruntimeassets_*.tgz filter=lfs diff=lfs merge=lfs -text
