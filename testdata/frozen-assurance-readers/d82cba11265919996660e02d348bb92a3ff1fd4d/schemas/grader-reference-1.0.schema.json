{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/microsoft/waza/main/schemas/grader-reference-1.0.schema.json",
  "title": "Waza grader reference labels 1.0",
  "description": "Exact label bytes require separate supplied current-source review. Declarations, hashes and finite corpus agreement do not authenticate humans or prove external state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "id", "version", "eval_source_sha256", "eval_resolved_config_sha256", "domains", "cases"],
  "properties": {
    "kind": { "const": "waza.grader-reference" },
    "schema_version": { "const": "1.0" },
    "id": { "$ref": "#/$defs/identity" },
    "version": { "$ref": "#/$defs/identity" },
    "eval_source_sha256": { "$ref": "#/$defs/sha256" },
    "eval_resolved_config_sha256": { "$ref": "#/$defs/sha256" },
    "implementation_executable_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "calibration": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["protocol", "model", "max_judge_executions"],
          "properties": {
            "protocol": { "const": "fixed_corpus_agreement_v1" },
            "model": { "$ref": "#/$defs/identity" },
            "max_judge_executions": { "type": "integer", "minimum": 1, "maximum": 100000 }
          }
        }
      ]
    },
    "domains": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "minimum_cases", "minimum_agreement"],
        "properties": {
          "id": { "$ref": "#/$defs/identity" },
          "minimum_cases": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "minimum_agreement": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
        }
      }
    },
    "cases": {
      "type": "array", "minItems": 1, "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "scenario_id", "domain", "classification", "task_id", "task_declaration_sha256", "manifest_sha256", "checks"],
        "oneOf": [
          { "required": ["snapshot"], "not": { "required": ["authored_input"] } },
          { "required": ["authored_input"], "not": { "required": ["snapshot"] } }
        ],
        "properties": {
          "id": { "$ref": "#/$defs/identity" },
          "scenario_id": { "$ref": "#/$defs/identity" },
          "domain": { "$ref": "#/$defs/identity" },
          "classification": { "enum": ["good", "alternative_valid", "critical_bad"] },
          "task_id": { "$ref": "#/$defs/identity" },
          "task_declaration_sha256": { "$ref": "#/$defs/sha256" },
          "snapshot": { "type": "string", "minLength": 1, "maxLength": 256, "description": "Canonical rooted relative path; no parent/dot segments, drive, backslash or symlink escape." },
          "authored_input": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "document_sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 256 },
              "document_sha256": { "$ref": "#/$defs/sha256" }
            },
            "description": "Exact original authored output envelope bytes; evaluator-only, never historical execution."
          },
          "manifest_sha256": { "$ref": "#/$defs/sha256" },
          "checks": {
            "type": "array", "minItems": 1, "maxItems": 100,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["requirement_id", "check", "grader_declaration_sha256", "expected_passed", "evidence"],
              "properties": {
                "requirement_id": { "$ref": "#/$defs/identity" },
                "check": { "$ref": "#/$defs/check" },
                "grader_declaration_sha256": { "$ref": "#/$defs/sha256" },
                "rubric_content_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
                "expected_passed": { "type": "boolean" },
                "evidence": {
                  "type": "array", "minItems": 1, "maxItems": 256,
                  "items": { "$ref": "#/$defs/reference" }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "$ref": "evidence-manifest-1.0.schema.json#/$defs/sha256" },
    "identity": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\u0000-\u0020\u007f](?:[^\u0000-\u001f\u007f]*[^\u0000-\u0020\u007f])?$" },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "grader"],
      "properties": {
        "scope": { "enum": ["eval", "task", "checkpoint"] },
        "grader": { "$ref": "#/$defs/identity" },
        "after_turn": { "type": "integer", "minimum": 1 }
      },
      "if": { "properties": { "scope": { "const": "checkpoint" } } },
      "then": { "required": ["after_turn"] },
      "else": { "not": { "required": ["after_turn"] } }
    },
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["origin", "artifact_id"],
      "properties": {
        "origin": {
          "allOf": [
            { "$ref": "evidence-manifest-1.0.schema.json#/$defs/origin" },
            {
              "properties": {
                "eval_id": { "$ref": "#/$defs/identity" },
                "task_id": { "$ref": "#/$defs/identity" },
                "run_number": { "minimum": 1 },
                "attempt_count": { "minimum": 1 }
              }
            }
          ]
        },
        "artifact_id": { "$ref": "#/$defs/identity" },
        "pointer": { "anyOf": [{ "const": "" }, { "$ref": "evidence-manifest-1.0.schema.json#/$defs/pointer" }] }
      }
    }
  }
}
