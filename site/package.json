{
  "name": "site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "dev:private-chat": "node --experimental-strip-types scripts/private-chat.mjs",
    "test:private-chat": "node --experimental-strip-types --test tests/private-chat.test.mjs",
    "start": "astro dev",
    "prebuild": "npm run test:docs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test:e2e": "playwright test",
    "test:chat": "playwright test --config=playwright.chat.config.ts",
    "test:chat-contract": "node --experimental-strip-types --test tests/chat-contract.test.mjs",
    "test:chat-unavailable": "playwright test --config=playwright.chat-unavailable.config.ts",
    "test:chat-metadata": "node --test tests/chat-knowledge.test.mjs",
    "test:chat-types": "tsc -p tsconfig.chat.json",
    "test:docs": "node --test tests/documentation.test.mjs",
    "test:examples": "node --test tests/examples.test.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.6",
    "astro": "^7.4.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "typescript": "6.0.3"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
